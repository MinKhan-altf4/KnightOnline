  "npcDefinitions": [
    {
      "definitionId": "mother_tutorial",
      "displayName": "Mẹ",
      "mapDefinitionId": "tutorial_map_01",
      "positionX": 3.0,
      "positionY": 0.0,
      "interactionRange": 3.0,
      "initialDialogue": "Con đã lớn rồi... Mẹ biết sẽ có ngày con rời ngôi làng này để đi con đường của một hiệp sĩ. Trước khi lên đường, hãy giúp dân làng tiêu diệt 20 con Sói ngoài bãi.",
      "progressDialogue": "Mẹ vẫn chờ con ở đây. Hãy cẩn thận với bầy Sói và trở về bình an nhé.",
      "completionDialogue": "Con đã trở về rồi... Mẹ tự hào về con. Đây là bộ giáp sắt Mẹ đã gìn giữ cho ngày con bắt đầu cuộc hành trình.",
      "farewellDialogue": "Hãy tiến về Safe Zone 1, gặp những người buôn bán và các hiệp sĩ khác. Dù con đi đâu, nơi này vẫn luôn là nhà. Tạm biệt con."
    }
