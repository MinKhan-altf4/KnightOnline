.hud-root {
    position: absolute;
    left: 28px;
    bottom: 28px;
    width: 420px;
    max-width: 42%;
}

/*
 * Kenney "Fantasy UI Borders" (CC0): white 48 px frames, 9-sliced at 12 px
 * and tinted here. Images live in Resources/UI/Kenney.
 *   frame-ornate  - outline with square corner ornaments (panels, dialogs)
 *   frame-corners - outline with small corner knots (secondary buttons)
 *   frame-plain   - plain outline (icon buttons)
 *   button-fill   - solid fill with corner knots (primary buttons)
 */
.kenney-frame,
.portal-popup,
.quest-card,
.function-menu-panel,
.connection-lost-dialog {
    background-image: resource("UI/Kenney/frame-ornate");
    -unity-background-image-tint-color: rgb(214, 168, 92);
    -unity-slice-left: 12;
    -unity-slice-top: 12;
    -unity-slice-right: 12;
    -unity-slice-bottom: 12;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}

.quest-card {
    padding: 22px 24px 18px 24px;
    background-color: rgba(9, 17, 29, 0.94);
}

.card-top-row,
.quest-heading-row,
.progress-row,
.card-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.map-name {
    color: rgb(255, 220, 151);
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.eyebrow,
.section-label,
.progress-caption {
    color: rgb(139, 158, 180);
    font-size: 10px;
    letter-spacing: 1.4px;
    -unity-font-style: bold;
}

.collapse-button {
    width: 34px;
    height: 32px;
    min-width: 34px;
    padding-left: 0;
    padding-right: 0;
    color: rgb(255, 226, 177);
    background-color: rgba(255, 255, 255, 0.04);
    background-image: resource("UI/Kenney/frame-plain");
    -unity-background-image-tint-color: rgb(150, 160, 175);
    -unity-slice-left: 12;
    -unity-slice-top: 12;
    -unity-slice-right: 12;
    -unity-slice-bottom: 12;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}

.collapse-button:hover {
    background-color: rgba(232, 171, 69, 0.14);
    -unity-background-image-tint-color: rgb(232, 171, 69);
}

.collapse-button:active {
    background-color: rgba(232, 171, 69, 0.26);
}

.quest-details {
    margin-top: 18px;
}

.status-pill {
    padding: 4px 8px;
    color: rgb(255, 220, 151);
    background-color: rgba(232, 171, 69, 0.16);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    font-size: 10px;
    -unity-font-style: bold;
}

.quest-title {
    margin-top: 10px;
    color: rgb(245, 247, 250);
    font-size: 19px;
    -unity-font-style: bold;
}

.quest-description {
    margin-top: 5px;
    color: rgb(180, 192, 207);
    font-size: 13px;
    white-space: normal;
}

.progress-row {
    margin-top: 18px;
}

.progress-text {
    color: rgb(235, 240, 246);
    font-size: 12px;
    -unity-font-style: bold;
}

.progress-track {
    height: 7px;
    margin-top: 7px;
    overflow: hidden;
    background-color: rgba(255, 255, 255, 0.12);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
}

.progress-fill {
    width: 0%;
    height: 100%;
    background-color: rgb(232, 171, 69);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
}

.card-footer {
    justify-content: flex-start;
    margin-top: 15px;
    padding-top: 11px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.1);
}

.footer-dot {
    width: 6px;
    height: 6px;
    margin-right: 8px;
    background-color: rgb(110, 205, 157);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

.footer-text {
    color: rgb(139, 158, 180);
    font-size: 11px;
}

.connection-lost-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
}

.connection-lost-overlay--visible {
    display: flex;
}

.connection-lost-dialog {
    width: 460px;
    max-width: 90%;
    padding: 24px;
    align-items: center;
    background-color: rgba(9, 17, 29, 0.97);
    -unity-background-image-tint-color: rgb(232, 171, 69);
}

.connection-lost-title {
    color: rgb(255, 150, 70);
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.connection-lost-message {
    color: rgb(230, 236, 245);
    font-size: 16px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 18px;
}

/* Primary action: solid gold plate with dark text. */
.kenney-primary-button,
.connection-lost-button,
.function-menu-toggle {
    color: rgb(30, 25, 17);
    background-color: rgba(0, 0, 0, 0);
    background-image: resource("UI/Kenney/button-fill");
    -unity-background-image-tint-color: rgb(232, 171, 69);
    -unity-slice-left: 12;
    -unity-slice-top: 12;
    -unity-slice-right: 12;
    -unity-slice-bottom: 12;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    -unity-font-style: bold;
}

.kenney-primary-button:hover,
.connection-lost-button:hover,
.function-menu-toggle:hover {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(250, 200, 110);
}

.kenney-primary-button:active,
.connection-lost-button:active,
.function-menu-toggle:active {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(190, 132, 46);
}

.connection-lost-button {
    min-width: 240px;
    height: 42px;
    padding-left: 18px;
    padding-right: 18px;
    font-size: 16px;
}

/* Portal refusal popup: shown when the player touches a portal they cannot use. */
.portal-popup-anchor {
    position: absolute;
    left: 0;
    right: 0;
    top: 16%;
    align-items: center;
}

.portal-popup {
    display: none;
    min-width: 380px;
    max-width: 70%;
    padding: 18px 30px 20px 30px;
    align-items: center;
    background-color: rgba(9, 17, 29, 0.95);
    -unity-background-image-tint-color: rgb(232, 171, 69);
    opacity: 0;
    translate: 0 -12px;
    transition-property: opacity, translate;
    transition-duration: 0.18s, 0.18s;
}

.portal-popup--visible {
    display: flex;
}

.portal-popup--shown {
    opacity: 1;
    translate: 0 0;
}

.portal-popup-title {
    margin-bottom: 6px;
    color: rgb(255, 220, 151);
    font-size: 13px;
    letter-spacing: 1.6px;
    -unity-font-style: bold;
}

.portal-popup-message {
    color: rgb(245, 247, 250);
    font-size: 18px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
}

.footer-text--warning {
    color: rgb(255, 150, 70);
    -unity-font-style: bold;
    white-space: normal;
}

.function-menu-anchor {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
}

.function-menu-panel {
    display: none;
    width: 100%;
    flex-shrink: 0;
    padding: 14px 18px 16px 18px;
    background-color: rgba(9, 17, 29, 0.97);
}

.function-menu-title {
    margin-bottom: 5px;
    color: rgb(255, 220, 151);
    font-size: 11px;
    letter-spacing: 1.2px;
    -unity-font-style: bold;
}

.function-menu-items {
    flex-direction: row;
    align-items: center;
}

.function-menu-item {
    flex-grow: 1;
    height: 38px;
    margin: 0 4px 0 0;
    color: rgb(235, 240, 246);
    background-color: rgba(255, 255, 255, 0.05);
    background-image: resource("UI/Kenney/frame-corners");
    -unity-background-image-tint-color: rgb(150, 160, 175);
    -unity-slice-left: 12;
    -unity-slice-top: 12;
    -unity-slice-right: 12;
    -unity-slice-bottom: 12;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    -unity-text-align: middle-center;
}

.function-menu-item:hover {
    color: rgb(255, 226, 177);
    background-color: rgba(232, 171, 69, 0.12);
    -unity-background-image-tint-color: rgb(232, 171, 69);
}

.function-menu-item:active {
    background-color: rgba(232, 171, 69, 0.24);
}

.disabled-item {
    opacity: 0.55;
}

.logout-item {
    margin-right: 0;
    color: rgb(255, 210, 200);
    background-color: rgba(170, 54, 44, 0.28);
    -unity-background-image-tint-color: rgb(205, 105, 90);
}

.logout-item:hover {
    color: rgb(255, 230, 222);
    background-color: rgba(190, 60, 48, 0.45);
    -unity-background-image-tint-color: rgb(240, 130, 110);
}

.function-menu-toggle {
    width: 64px;
    height: 34px;
    min-width: 64px;
    flex-shrink: 0;
    padding-left: 0;
    padding-right: 0;
    font-size: 20px;
}

@media (max-width: 700px) {
    .function-menu-item {
        height: 34px;
        font-size: 11px;
    }
}
